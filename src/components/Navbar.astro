---
import { COMPANY_INFO } from '../data/company';
import { Phone, ArrowRight, MessageSquare } from 'lucide-astro';

const waLink = `https://wa.me/${COMPANY_INFO.whatsappNumber}?text=${encodeURIComponent(COMPANY_INFO.whatsappMessage)}`;

const navLinks = [
  { label: 'Beranda', href: '#beranda' },
  { label: 'Tentang Kami', href: '#tentang-kami' },
  { label: 'Produk & Layanan', href: '#layanan' },
  { label: 'Proyek', href: '#proyek' },
  { label: 'Kontak', href: '#kontak' },
];

const desktopLeftLinks = [
  { label: 'Beranda', href: '#beranda' },
  { label: 'Tentang', href: '#tentang-kami' },
  { label: 'Layanan', href: '#layanan' },
  { label: 'Mutu Beton', href: '#mutu-beton' },
];

const desktopRightLinks = [
  { label: 'Proyek', href: '#proyek' },
  { label: 'Area', href: '#area-layanan' },
  { label: 'Kontak', href: '#kontak' },
];
---

<!-- ═══════════════════════════════════════════
     DESKTOP NAVBAR — Floating capsule (unchanged)
     ═══════════════════════════════════════════ -->
<header class="hidden lg:block fixed top-0 left-0 right-0 z-50 px-6 pt-4 pointer-events-none">
  <div class="max-w-6xl mx-auto bg-white/95 backdrop-blur-md rounded-full shadow-lg shadow-black/10 border border-slate-200/90 px-7 py-2.5 flex items-center justify-between pointer-events-auto">
    
    <!-- Left Navigation Links -->
    <nav class="flex items-center space-x-6 text-xs font-bold uppercase tracking-wider text-slate-700">
      {desktopLeftLinks.map(link => (
        <a href={link.href} class="hover:text-safety-600 transition-colors">{link.label}</a>
      ))}
    </nav>

    <!-- Center Brand Logo -->
    <a href="#beranda" class="flex items-center space-x-2.5 group">
      <div class="w-9 h-9 rounded-lg bg-safety-600 text-white flex items-center justify-center shadow-sm">
        <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
          <polyline points="2 17 12 22 22 17"></polyline>
          <polyline points="2 12 12 17 22 12"></polyline>
        </svg>
      </div>
      <div class="flex flex-col text-left">
        <div class="flex items-center space-x-1">
          <span class="font-display text-xl font-black tracking-tight text-slate-900 leading-none">AMS</span>
          <span class="font-display text-xl font-black tracking-tight text-safety-600 leading-none">BETON</span>
        </div>
        <span class="text-[9px] uppercase tracking-widest font-bold text-slate-400 leading-none mt-0.5">
          CV Anugerah Mecca Sejahtera
        </span>
      </div>
    </a>

    <!-- Right Navigation + CTA -->
    <div class="flex items-center space-x-6">
      <nav class="flex items-center space-x-6 text-xs font-bold uppercase tracking-wider text-slate-700">
        {desktopRightLinks.map(link => (
          <a href={link.href} class="hover:text-safety-600 transition-colors">{link.label}</a>
        ))}
      </nav>
      <a 
        href={`tel:${COMPANY_INFO.phone}`}
        class="inline-flex items-center space-x-2 px-4 py-2 rounded-full bg-safety-600 hover:bg-safety-700 text-white font-bold text-xs tracking-wide shadow-sm transition-colors"
      >
        <Phone class="w-3.5 h-3.5 fill-current" />
        <span>{COMPANY_INFO.phoneFormatted}</span>
      </a>
    </div>

  </div>
</header>


<!-- ═══════════════════════════════════════════
     MOBILE NAVBAR — Premium industrial sticky
     ═══════════════════════════════════════════ -->
<header 
  id="mobile-header"
  class="lg:hidden fixed top-0 left-0 right-0 z-50 bg-white border-b border-slate-200/80"
>
  <!-- Top bar -->
  <div class="flex items-center justify-between px-4 h-14">
    
    <!-- Logo -->
    <a href="#beranda" class="flex items-center space-x-2 flex-shrink-0">
      <div class="w-8 h-8 rounded-md bg-safety-600 text-white flex items-center justify-center">
        <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
          <polyline points="2 17 12 22 22 17"></polyline>
          <polyline points="2 12 12 17 22 12"></polyline>
        </svg>
      </div>
      <div class="flex flex-col">
        <div class="flex items-center space-x-0.5 leading-none">
          <span class="font-display text-lg font-black tracking-tight text-slate-900">AMS</span>
          <span class="font-display text-lg font-black tracking-tight text-safety-600">BETON</span>
        </div>
      </div>
    </a>

    <!-- Right actions -->
    <div class="flex items-center space-x-2">
      <!-- Hubungi Kami button -->
      <a 
        href={`tel:${COMPANY_INFO.phone}`}
        class="inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-md bg-safety-600 text-white text-xs font-semibold tracking-wide hover:bg-safety-700 active:bg-safety-800 transition-colors"
      >
        <Phone class="w-3.5 h-3.5" />
        <span>Hubungi Kami</span>
      </a>

      <!-- Hamburger / Close toggle -->
      <button
        id="mobile-nav-toggle"
        class="relative w-10 h-10 flex items-center justify-center text-slate-800 focus:outline-none"
        aria-label="Toggle navigasi"
        aria-expanded="false"
      >
        <!-- Hamburger icon (3 bars, animated) -->
        <div id="hamburger-icon" class="flex flex-col justify-center items-center w-5 h-5 space-y-[5px] transition-all duration-300">
          <span class="hamburger-bar block w-5 h-[2px] bg-slate-800 rounded-full transition-all duration-300 origin-center"></span>
          <span class="hamburger-bar block w-5 h-[2px] bg-slate-800 rounded-full transition-all duration-300 origin-center"></span>
          <span class="hamburger-bar block w-3.5 h-[2px] bg-slate-800 rounded-full transition-all duration-300 origin-center ml-0"></span>
        </div>
      </button>
    </div>
  </div>

  <!-- ───── Mobile fullscreen panel ───── -->
  <nav 
    id="mobile-nav-panel"
    class="mobile-panel-closed overflow-hidden bg-white border-t border-slate-100"
    aria-hidden="true"
  >
    <div class="px-5 py-6">

      <!-- Navigation links -->
      <ul class="space-y-1">
        {navLinks.map((link, i) => (
          <li>
            <a 
              href={link.href}
              class="mobile-nav-link group flex items-center justify-between py-3.5 px-3 rounded-md text-slate-800 hover:bg-slate-50 active:bg-slate-100 transition-colors"
              style={`transition-delay: ${i * 50}ms;`}
            >
              <span class="text-base font-semibold">{link.label}</span>
              <ArrowRight class="w-4 h-4 text-slate-300 group-hover:text-safety-600 group-hover:translate-x-0.5 transition-all" />
            </a>
          </li>
        ))}
      </ul>

      <!-- Divider -->
      <div class="my-4 h-px bg-slate-100"></div>

      <!-- CTA buttons -->
      <div class="space-y-2.5">
        <a 
          href="#penawaran"
          class="mobile-nav-link flex items-center justify-center w-full py-3 px-4 rounded-md bg-safety-600 hover:bg-safety-700 active:bg-safety-800 text-white font-semibold text-sm tracking-wide transition-colors"
        >
          <span>Minta Penawaran Harga</span>
          <ArrowRight class="w-4 h-4 ml-2" />
        </a>
        <a 
          href={waLink}
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-nav-link flex items-center justify-center w-full py-3 px-4 rounded-md bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-semibold text-sm tracking-wide transition-colors"
        >
          <MessageSquare class="w-4 h-4 mr-2" />
          <span>Konsultasi WhatsApp</span>
        </a>
      </div>

      <!-- Contact info -->
      <div class="mt-5 pt-4 border-t border-slate-100">
        <p class="text-xs text-slate-400 font-medium">{COMPANY_INFO.workingHours}</p>
      </div>

    </div>
  </nav>
</header>

<!-- Spacer for mobile sticky header -->
<div class="lg:hidden h-14"></div>

<style>
  /* ── Panel open/close animation ── */
  .mobile-panel-closed {
    max-height: 0;
    opacity: 0;
    transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.25s ease;
  }

  .mobile-panel-open {
    max-height: 100vh;
    opacity: 1;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.2s ease;
  }

  /* ── Hamburger → X animation ── */
  .menu-open .hamburger-bar:nth-child(1) {
    transform: translateY(3.5px) rotate(45deg);
  }
  .menu-open .hamburger-bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .menu-open .hamburger-bar:nth-child(3) {
    width: 1.25rem;
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* ── Link entrance stagger ── */
  .mobile-panel-closed .mobile-nav-link {
    opacity: 0;
    transform: translateY(8px);
  }
  .mobile-panel-open .mobile-nav-link {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  /* ── Shadow on scroll ── */
  #mobile-header.scrolled {
    box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.06), 0 1px 2px -1px rgb(0 0 0 / 0.06);
  }
</style>

<script>
  const toggle = document.getElementById('mobile-nav-toggle') as HTMLButtonElement | null;
  const panel = document.getElementById('mobile-nav-panel') as HTMLElement | null;
  const header = document.getElementById('mobile-header') as HTMLElement | null;
  const hamburgerIcon = document.getElementById('hamburger-icon') as HTMLElement | null;
  const links = document.querySelectorAll<HTMLAnchorElement>('.mobile-nav-link');

  let isOpen = false;

  function openMenu() {
    if (!panel || !toggle || !hamburgerIcon) return;
    isOpen = true;
    panel.classList.remove('mobile-panel-closed');
    panel.classList.add('mobile-panel-open');
    panel.setAttribute('aria-hidden', 'false');
    toggle.setAttribute('aria-expanded', 'true');
    hamburgerIcon.classList.add('menu-open');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    if (!panel || !toggle || !hamburgerIcon) return;
    isOpen = false;
    panel.classList.remove('mobile-panel-open');
    panel.classList.add('mobile-panel-closed');
    panel.setAttribute('aria-hidden', 'true');
    toggle.setAttribute('aria-expanded', 'false');
    hamburgerIcon.classList.remove('menu-open');
    document.body.style.overflow = '';
  }

  // Toggle on button click
  toggle?.addEventListener('click', () => {
    isOpen ? closeMenu() : openMenu();
  });

  // Close on link click
  links.forEach(link => {
    link.addEventListener('click', () => {
      closeMenu();
    });
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      closeMenu();
      toggle?.focus();
    }
  });

  // Shadow on scroll
  if (header) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 10) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
    }, { passive: true });
  }

  // Close menu on resize to desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024 && isOpen) {
      closeMenu();
    }
  });
</script>
