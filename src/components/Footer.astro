---
import { COMPANY_INFO, CONCRETE_GRADES } from '../data/company';
import { Phone, MapPin, MessageSquare, ArrowRight } from 'lucide-astro';

const currentYear = new Date().getFullYear();
const waLink = `https://wa.me/${COMPANY_INFO.whatsappNumber}?text=${encodeURIComponent(COMPANY_INFO.whatsappMessage)}`;
---

<footer class="bg-industrial-950 text-industrial-400 py-10 sm:py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10 mb-8 sm:mb-12">
      
      <!-- Company Brand & Intro (lg:col-span-4) -->
      <div class="lg:col-span-4 space-y-3">
        <div class="flex items-center space-x-2.5">
          <div class="w-8 h-8 rounded bg-safety-600 text-white font-black flex items-center justify-center text-sm">
            AMS
          </div>
          <div>
            <span class="text-base sm:text-lg font-bold text-white block leading-tight">
              AMS BETON
            </span>
            <span class="text-[11px] text-industrial-400 block">
              {COMPANY_INFO.legalName}
            </span>
          </div>
        </div>

        <p class="text-xs text-industrial-300 leading-relaxed max-w-sm">
          Penyedia pasokan beton cor ready mix dan layanan sewa pompa beton dengan acuan standar SNI 2847:2019. Melayani armada truk standar 7 m³ dan MiniMix 3 m³ di Jabodetabek dan sekitarnya.
        </p>

        <div class="text-[11px] text-industrial-400 pt-1 space-y-0.5">
          <div class="text-white font-semibold">Badan Hukum Terdaftar</div>
          <div>{COMPANY_INFO.legalName}</div>
        </div>
      </div>

      <!-- Navigation Links (lg:col-span-2) -->
      <div class="lg:col-span-2 space-y-2.5">
        <h4 class="text-xs font-bold text-white uppercase tracking-wider">
          Navigasi
        </h4>
        <ul class="space-y-1.5 text-xs">
          <li><a href="#beranda" class="hover:text-white transition-colors">Beranda</a></li>
          <li><a href="#tentang-kami" class="hover:text-white transition-colors">Tentang Kami</a></li>
          <li><a href="#layanan" class="hover:text-white transition-colors">Layanan Pengecoran</a></li>
          <li><a href="#keunggulan" class="hover:text-white transition-colors">Standar Kualitas</a></li>
          <li><a href="#proyek" class="hover:text-white transition-colors">Referensi Aplikasi</a></li>
          <li><a href="#area-layanan" class="hover:text-white transition-colors">Area Layanan</a></li>
          <li><a href="#penawaran" class="hover:text-white transition-colors">Kalkulator Kubikasi</a></li>
          <li><a href="#kontak" class="hover:text-white transition-colors">Kontak & Pemesanan</a></li>
        </ul>
      </div>

      <!-- Concrete Grades Links (lg:col-span-3) -->
      <div class="lg:col-span-3 space-y-2.5">
        <h4 class="text-xs font-bold text-white uppercase tracking-wider">
          Mutu Beton Acuan SNI
        </h4>
        <ul class="space-y-1.5 text-xs">
          {CONCRETE_GRADES.map((item) => (
            <li>
              <a href="#mutu-beton" class="hover:text-white transition-colors flex items-center justify-between">
                <span class="hover:text-safety-500 transition-colors">{item.grade} ({item.strengthKg})</span>
                <span class="text-[11px] text-industrial-500">{item.category}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Direct Contact Channels (lg:col-span-3) -->
      <div class="lg:col-span-3 space-y-2.5">
        <h4 class="text-xs font-bold text-white uppercase tracking-wider">
          Kontak Layanan
        </h4>
        <div class="space-y-2 text-xs text-industrial-300">
          <p class="flex items-center space-x-2">
            <Phone class="w-3.5 h-3.5 text-safety-500 shrink-0" />
            <a href={`tel:${COMPANY_INFO.phone}`} class="hover:text-white transition-colors font-bold text-white">
              {COMPANY_INFO.phoneFormatted}
            </a>
          </p>
          <p class="flex items-center space-x-2">
            <MessageSquare class="w-3.5 h-3.5 text-emerald-400 shrink-0" />
            <a href={waLink} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors text-emerald-300">
              WhatsApp: {COMPANY_INFO.phoneFormatted}
            </a>
          </p>
          <p class="flex items-start space-x-2 text-[11px] text-industrial-400 pt-0.5">
            <MapPin class="w-3.5 h-3.5 text-safety-500 shrink-0 mt-0.5" />
            <span>Jalur Pengiriman Jabodetabek & Karawang</span>
          </p>
        </div>

        <div class="pt-1.5">
          <a
            href={waLink}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-2 px-3 bg-industrial-900 hover:bg-industrial-850 text-emerald-300 text-xs font-bold rounded flex items-center justify-center space-x-1.5 transition-colors"
          >
            <span>Konsultasi via WhatsApp</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-6 border-t border-industrial-900 flex flex-col sm:flex-row items-center justify-between text-[11px] text-industrial-400 gap-3">
      <div>
        &copy; {currentYear} {COMPANY_INFO.legalName} (AMS Beton). Hak Cipta Dilindungi.
      </div>
      <div class="flex items-center space-x-2 text-[11px]">
        <span>Acuan Standar Teknis:</span>
        <span>SNI 2847:2019</span>
        <span>•</span>
        <span>PBI 1971</span>
        <span>•</span>
        <span>ASTM C94</span>
      </div>
    </div>

  </div>

  <!-- Floating Sticky WhatsApp Quick Action (mobile responsive) -->
  <div class="fixed bottom-4 right-4 z-40">
    <a
      href={waLink}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center space-x-1.5 px-3.5 py-2.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-lg shadow-emerald-900/40 transition-colors"
      aria-label="Konsultasi WhatsApp"
    >
      <MessageSquare class="w-4 h-4 text-white" />
      <span>WhatsApp PIC</span>
    </a>
  </div>
</footer>
